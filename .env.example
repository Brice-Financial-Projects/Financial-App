# ======================================================
# BudgetSync Environment Configuration (Example)
# ======================================================
# Copy to `.env` and populate with real values.
# NEVER commit the real `.env` file.
# ======================================================


# ----------------------
# Application Settings
# ----------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-secret-key


# ----------------------
# Database (Turso / libSQL)
# ----------------------
DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=


# ----------------------
# SQLAlchemy
# ----------------------
SQLALCHEMY_ECHO=0
SQLALCHEMY_TRACK_MODIFICATIONS=0


# ----------------------
# Authentication / Security
# ----------------------
BCRYPT_LOG_ROUNDS=12
LOGIN_DISABLED=0


# ----------------------
# Admin Seed (REQUIRED FOR seed.py)
# ----------------------
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=


# ----------------------
# SendGrid Email (Password Reset)
# ----------------------
SENDGRID_API_KEY=
MAIL_DEFAULT_SENDER=no-reply@yourdomain.com
MAIL_FROM_NAME=BudgetSync


# ----------------------
# Password Reset Tokens
# ----------------------
PASSWORD_RESET_EXPIRATION_HOURS=1


# ----------------------
# Session / Cookies
# ----------------------
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax


# ----------------------
# Feature Flags
# ----------------------
ENABLE_EMAIL_NOTIFICATIONS=1
ENABLE_ADMIN_PANEL=1
ENABLE_REGISTRATION=1
